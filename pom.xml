<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.octri</groupId>
  <artifactId>octri-monitoring</artifactId>
  <version>0.0.0</version>
  <name>Octri Monitoring for Java</name>
  <description>Standalone application monitoring and error reporting for Java.</description>
  <url>https://octri.dev</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Octri</name>
      <organization>Octri</organization>
      <organizationUrl>https://octri.dev</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/octridev/octri-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/octridev/octri-java.git</developerConnection>
    <url>https://github.com/octridev/octri-java</url>
  </scm>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
